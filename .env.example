# Safe default: no paid provider calls.
VEO_PROVIDER=mock

# Required only when VEO_PROVIDER=google.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VEO_OUTPUT_GCS_URI=gs://your-private-bucket/sceneflow
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional short-lived local-development alternative to service-account auth.
GOOGLE_ACCESS_TOKEN=

# Optional external FFmpeg/Cloud Run service.
RENDER_SERVICE_URL=
RENDER_SERVICE_SECRET=
RENDER_OUTPUT_GCS_URI=gs://your-private-bucket/sceneflow-rendered
